* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #f0f4f8;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
}

.container {
  background: white;
  padding: 30px;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  text-align: center;
  max-width: 450px;
  width: 100%;
}

h1 {
  color: #2c3e50;
  margin-bottom: 5px;
  font-size: 1.8rem;
}

.subtitle {
  color: #7f8c8d;
  margin-bottom: 20px;
}

.turn-indicator {
  font-size: 1.2rem;
  font-weight: bold;
  margin-bottom: 20px;
  color: #34495e;
}

#currentPlayer {
  color: #e74c3c;
  font-size: 1.4rem;
}

.board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 25px;
}

.cell {
  width: 100%;
  aspect-ratio: 1;
  font-size: 2.5rem;
  font-weight: bold;
  background-color: #ecf0f1;
  border: 2px solid #bdc3c7;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  color: #7f8c8d;
}

.cell:hover {
  background-color: #e2e8f0;
  transform: scale(1.02);
}

.cell.x {
  color: #e74c3c;
  background-color: #fadbd8;
}

.cell.o {
  color: #3498db;
  background-color: #d6eaf8;
}

#restartBtn {
  background-color: #2ecc71;
  color: white;
  border: none;
  padding: 12px 24px;
  font-size: 1rem;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  transition: background 0.2s;
}

#restartBtn:hover {
  background-color: #27ae60;
}

/* Modal */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  justify-content: center;
  align-items: center;
}

.modal-content {
  background: white;
  padding: 25px;
  border-radius: 12px;
  width: 90%;
  max-width: 350px;
  text-align: center;
  box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

.modal-content h3 {
  margin-bottom: 15px;
  color: #2c3e50;
}

#questionText {
  font-size: 1.3rem;
  font-weight: bold;
  margin-bottom: 15px;
  color: #2980b9;
}

#answerInput {
  width: 80%;
  padding: 10px;
  font-size: 1.1rem;
  text-align: center;
  margin-bottom: 15px;
  border: 2px solid #bdc3c7;
  border-radius: 6px;
}

.modal-buttons button {
  background-color: #3498db;
  color: white;
  border: none;
  padding: 10px 20px;
  font-size: 1rem;
  border-radius: 6px;
  cursor: pointer;
}

.feedback {
  margin-top: 10px;
  font-weight: bold;
}
